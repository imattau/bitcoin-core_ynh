#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Installing Bitcoin Core binaries..."
ynh_setup_source --dest_dir="$install_dir"
ynh_bitcoin_unpack

ynh_script_progression "Preparing Bitcoin Core data and configuration..."
mkdir -p "$data_dir" "$data_dir/wallets"
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"
ynh_bitcoin_write_config

ynh_script_progression "Registering Bitcoin Core service..."
yunohost service add "$service_name" --description="Bitcoin Core headless node" --log=systemd || true
ynh_config_add_systemd

ynh_script_progression "Starting Bitcoin Core..."
ynh_systemctl --service="$service_name" --action=start --log_path=systemd --timeout=60
ynh_bitcoin_healthcheck || ynh_die "Bitcoin Core RPC did not become available"
ynh_print_info "Initial blockchain synchronization has started; installation does not wait for IBD to finish."

