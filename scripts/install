#!/bin/bash
set -eu
source /usr/share/yunohost/helpers
source "$(dirname "$0")/_common.sh"

ynh_script_progression "Installing Bitcoin Core binaries..."
ynh_setup_source --dest_dir="$install_dir"
ynh_bitcoin_unpack

ynh_script_progression "Preparing Bitcoin Core data and configuration..."
mkdir -p "$data_dir" "$data_dir/wallets"
chown -R "$app:$app" "$data_dir"
chmod 750 "$data_dir"
ynh_bitcoin_ensure_cln_credential
ynh_app_setting_set --app="$app" --key=pruning --value="${pruning:-pruned-25G}"
ynh_app_setting_set --app="$app" --key=p2p_incoming --value="${p2p_incoming:-1}"
ynh_app_setting_set --app="$app" --key=start_sync --value="${start_sync:-1}"
ynh_bitcoin_write_config

ynh_script_progression "Registering Bitcoin Core service..."
yunohost service add "$service_name" --description="Bitcoin Core headless node"
ynh_config_add_systemd

if [ "${start_sync:-1}" -eq 1 ]; then
	ynh_script_progression "Starting Bitcoin Core and blockchain synchronization..."
	ynh_systemctl --service="$service_name" --action=start --log_path=systemd --timeout=60
	ynh_bitcoin_healthcheck || ynh_die "Bitcoin Core RPC did not become available"
	ynh_print_info "Initial blockchain synchronization has started; installation does not wait for IBD to finish."
else
	ynh_script_progression "Leaving Bitcoin Core stopped until synchronization is enabled..."
	ynh_print_info "No blockchain download has started. Enable synchronization later from the YunoHost Config Panel."
fi
