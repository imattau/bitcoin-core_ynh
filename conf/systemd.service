[Unit]
Description=Bitcoin Core headless node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__APP__
Group=__APP__
ExecStart=__INSTALL_DIR__/bitcoin-31.1/bin/bitcoind -conf=/etc/__APP__/bitcoin.conf -datadir=__DATA_DIR__ -printtoconsole
ExecStop=__INSTALL_DIR__/bitcoin-31.1/bin/bitcoin-cli -conf=/etc/__APP__/bitcoin.conf -datadir=__DATA_DIR__ stop
Restart=on-failure
RestartSec=10
TimeoutStopSec=600
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=__DATA_DIR__

[Install]
WantedBy=multi-user.target

